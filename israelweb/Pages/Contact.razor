@page "/contact"

      <div class="slide" id="5">
            <div class="content fifth-content">
                <div class="container-fluid">
                    <div class="col-md-6">
                        <div id="map">

                           <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3967.336043202337!2d-0.2639787242880627!3d6.085347228098441!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xfdf41cb373a9c3d%3A0x48e9b6ac4d67db05!2sKoforidua!5e0!3m2!1sen!2sgh!4v1725034868502!5m2!1sen!2sgh" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <form id="contact" action="#" method="post" autocomplete="off">
                            <div class="row">
                                <div class="col-md-12">
                                  <fieldset>
                                    <input name="name" type="text" class="form-control" id="name" placeholder="Your name..." required>
                                  </fieldset>
                                </div>
                                <div class="col-md-12">
                                  <fieldset>
                                    <input name="email" type="email" class="form-control" id="email" placeholder="Your email..." required>
                                  </fieldset>
                                </div>
                                 <div class="col-md-12">
                                  <fieldset>
                                    <input name="subject" type="text" class="form-control" id="subject" placeholder="Subject..." required>
                                  </fieldset>
                                </div>
                                <div class="col-md-12">
                                  <fieldset>
                                    <textarea name="message" rows="6" class="form-control" id="message" placeholder="Your message..." required></textarea>
                                  </fieldset>
                                </div>
                                <div class="col-md-12">
                                  <fieldset>
                                    <button type="submit" id="form-submit" class="btn">Send Now</button>
                                  </fieldset>
                                </div>
                            </div>
                            <div id="form-loading-overlay">
                                <div class="form-spinner"></div>
                            </div>
                            <div id="form-success-modal">
                                <div class="form-success-content">
                                    <button class="form-success-close" onclick="closeSuccessModal()">&times;</button>
                                    <h3>Thank you!</h3>
                                    <p>Your message has been sent successfully.</p>
                                </div>
                            </div>
                        </form>

                        <script>
                        const scriptURL = 'https://script.google.com/macros/s/AKfycbytyWqNKrU9fD-2afyQ9WhzD-Ja5BPQDBqTJAaPDqrVdNpNvG-nBi7ifr_fVH-Xk70jmw/exec';
                        const form = document.getElementById('contact');
                        const loadingOverlay = document.getElementById('form-loading-overlay');
                        const successModal = document.getElementById('form-success-modal');

                        form.addEventListener('submit', async function(e) {
                            e.preventDefault();
                            loadingOverlay.classList.add('active');
                            const formData = new FormData(form);
                            const params = new URLSearchParams();
                            for (const pair of formData.entries()) {
                                params.append(pair[0], pair[1]);
                            }
                            try {
                                const response = await fetch(scriptURL, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                    body: params
                                });
                                let result = null;
                                try {
                                    result = await response.json();
                                } catch (parseErr) {
                                    result = { success: true };
                                }
                                loadingOverlay.classList.remove('active');
                                form.reset();
                                showSuccessModal();
                            } catch (error) {
                                loadingOverlay.classList.remove('active');
                                form.reset();
                                showSuccessModal();
                            }
                        });

                        function showSuccessModal() {
                            successModal.classList.add('active');
                            setTimeout(closeSuccessModal, 4000); // Auto-close after 4s
                        }
                        function closeSuccessModal() {
                            successModal.classList.remove('active');
                        }
                        </script>
                    </div>
                </div>
            </div>
          </div>